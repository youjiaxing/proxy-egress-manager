# Copy to .env, set all required values; never commit a real .env.
# For local build only: PEM_IMAGE=proxy-egress-manager:local
# For published production image: ghcr.io/YOUR_NAMESPACE/proxy-egress-manager:vX.Y.Z@sha256:...
PEM_IMAGE=
PUBLIC_URL=https://egress.example.com
BUSINESS_NETWORK=
CORE_SECRET=
ADMIN_PASSWORD=
WEB_HOST_PORT=18080
GROUP_CAPACITY=32
SOURCE_CAPACITY=16
